<!DOCTYPE html>
<html>
<head>
    {% block meta %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    {% endblock meta %}
    <title>{% block title %}{{ swagger_data.spec.info.title }}{% endblock title %}</title>
</head>
<body>
    {% block swagger_ui %}
        <div id="scalar-api-reference"></div>
        <script id="scalar-api-reference-data" type="application/json">{{ swagger_data.spec|json_encode(65)|raw }}</script>
    {% endblock swagger_ui %}
    {% block swagger_initialization %}
        {{ nelmioAsset(assets_mode, 'scalar/scalar.standalone.js') }}
        <script>
            Scalar.createApiReference('#scalar-api-reference', {
                title: {{ swagger_data.spec.info.title|default('API')|json_encode(65)|raw }},
                ...{{ scalar_config|json_encode(65)|raw }},
                content: JSON.parse(document.getElementById('scalar-api-reference-data').textContent),
            });
        </script>
    {% endblock swagger_initialization %}
</body>
</html>
